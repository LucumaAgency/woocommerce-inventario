# Dependencias
# OJO: vendor/ SI se committea. Git Updater no ejecuta composer install, asi que
# las dependencias tienen que viajar con el codigo.
/node_modules/

# Sistema
.DS_Store
Thumbs.db

# Editores
.idea/
.vscode/
*.sublime-*

# Logs y temporales
*.log
*.tmp

# Certificados y llaves — NUNCA subir al repo (identidad tributaria de saraih)
*.p12
*.pfx
*.pem
*.key
*.crt
certs/

# Excepcion: el certificado de PRUEBA de Greenter si va al repo (es publico y
# autofirmado, y hace falta para el sandbox). Los reales siguen excluidos.
!certs-prueba/*.pem

# Ojo en la Fase 2: al dejar de ignorar /vendor/ para poder committearlo (Git
# Updater no ejecuta composer install), el certificado de prueba de Greenter
# viaja como .pem dentro de vendor/ y la regla *.pem de arriba lo excluiría en
# silencio, con un fallo de firma difícil de diagnosticar. Añadir entonces:
#   !vendor/**/*.pem
